# Copy to .env.local for development. Set the real values in the Vercel
# dashboard for preview/production. Never commit .env.local.

# --- Buyer update portal (/litters/[slug]/updates) --------------------------
#
# Signing key for the access cookie. Any random string of 16+ characters;
# 32 bytes of base64 is a good default. Rotating this immediately invalidates
# every buyer's saved access — it is the panic button.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
LITTER_ACCESS_SECRET=

# One passcode per litter. The env var name is declared on each Litter record
# in src/lib/placeholder-data.ts (`passcodeEnvKey`).
#
# Rules for choosing these:
#   1. At least 10 characters, mixing words and digits. There is no rate
#      limiting on the gate (see src/lib/litter-access.ts), so short or numeric
#      codes are brute-forceable.
#   2. Do NOT use any value that has ever appeared in this repo, a commit
#      message, or a chat log — this repository is PUBLIC.
#   3. Do NOT derive them from the litter name. If the codes follow a visible
#      pattern, a buyer holding one can guess the others.
#
# No example is given here on purpose. Generate one per litter:
#   node -e "console.log(require('crypto').randomBytes(6).toString('base64url'))"
LITTER_PASSCODE_KINGS=
LITTER_PASSCODE_CINEMA=

# --- Phase 4: Stripe (client's own account) ---------------------------------
# Created by the client in their own Stripe dashboard and set by them in Vercel.
# We never handle these values (ADR-003).
# STRIPE_SECRET_KEY=
